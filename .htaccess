## ONEPANEL Force HTTPS by SSL installation
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]
Header always set Content-Security-Policy "upgrade-insecure-requests;"
## ONEPANEL Force HTTPS by SSL installation end

# Chan truy cap truc tiep cac file cau hinh/du lieu nhay cam qua HTTP - PHP require() van doc
# duoc binh thuong (chan la o tang HTTP, khong anh huong include noi bo).
<FilesMatch "^(config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|md|gz|zip|bak|old|ini|env|lock)$">
    Require all denied
</FilesMatch>

# error_log khong co dau cham nen luat theo duoi file o tren KHONG bat duoc no. Hien may chu
# dang tra 403 nhung do la mac dinh cua LiteSpeed - khai bao thang ra day de khong phu thuoc
# vao mac dinh cua may chu (log loi thuong lo duong dan, cau truy van, doi khi ca du lieu that).
<FilesMatch "^(error_log|\.env|\.git.*|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

Options -Indexes

# Chinh sach bao mat noi dung (CSP) chat hon dong "upgrade-insecure-requests" cua khoi ONEPANEL o tren (dong sau ghi de dong truoc).
# Cac nguon ngoai duy nhat app dung: thu vien quet ma vach (jsdelivr), JsBarcode/qrcodejs (cdnjs), anh VietQR (img.vietqr.io, nam trong img-src https:),
# va POST ve kt-soft.vn/feedback_api.php. Khong dat form-action vi thanh toan VNPay chuyen huong sang pay.vnpay.vn sau khi POST.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://kt-soft.vn; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; upgrade-insecure-requests"
Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
